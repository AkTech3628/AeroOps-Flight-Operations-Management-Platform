# Copy to .env for local development. Never commit the real .env.
# On Render, set these in the service's Environment tab instead.

# MongoDB connection string (Atlas: mongodb+srv://...; local: mongodb://127.0.0.1:27017/aeroops)
MONGO_URL=

# Long random string used to sign login tokens
JWT_SECRET=

# Redis URL (Upstash: rediss://default:<password>@<host>:6379 - no quotes). Optional: the API works without Redis.
REDIS_URL=redis://127.0.0.1:6379

# AviationStack key, only needed for the admin "sync" button
AVIATION_API_KEY=

# Comma-separated list of allowed frontend origins (required in production), e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

PORT=3000
